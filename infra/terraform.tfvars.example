# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored:
# it is machine- and account-specific, and may contain your own IP address.

aws_region    = "us-east-1"
project_name  = "tictactest"
instance_type = "t3.micro"

# Seed version for the very first boot. Afterwards the DEPLOYMENT decides
# which version runs - leave this alone when releasing.
# initial_version = "1.2.0"

# Deployments go through SSM, so SSH stays closed by default.
# Open it for your own address only if you need to debug on the instance:
# ssh_ingress_cidrs = ["203.0.113.4/32"]
# ssh_key_name      = "vockey"
